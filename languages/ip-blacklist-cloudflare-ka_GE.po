msgstr "ავტორიზაციის მონაცემების შეცვლა"

#: classes/Plugin.php:104
msgid "Cancel"
msgstr "გაუქმება"

#: classes/Plugin.php:105
#: views/SiteSettingsView.php:293
msgid "Disconnect"
msgstr "გათიშვა"

#: classes/Plugin.php:106
msgid "Are you sure you want to disconnect? Your Cloudflare credentials will be removed."
msgstr "დარწმუნებული ხართ, რომ გსურთ გათიშვა? თქვენი Cloudflare ავტორიზაციის მონაცემები წაიშლება."

