msgstr "დაკავშირებულია %sCloudflare დანამატის%s მეშვეობით."

#: views/SiteSettingsView.php:286
#, php-format
msgid "Connected via %s"
msgstr "დაკავშირებულია %s-ის მეშვეობით"

#: views/SiteSettingsView.php:313
