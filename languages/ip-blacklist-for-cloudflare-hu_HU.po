#, php-format
msgid "Connected via %s"
msgstr "Kapcsolódva: %s"

#: views/SiteSettingsView.php:313
msgid "Please set your Cloudflare credentials below or install and configure the <a href=\"http://wordpress.org/plugins/cloudflare/\" target=\"_blank\">official Cloudflare plugin</a> to continue."
msgstr "Kérjük, adja meg a Cloudflare hitelesítő adatait alább, vagy telepítse és konfigurálja a <a href=\"http://wordpress.org/plugins/cloudflare/\" target=\"_blank\">hivatalos Cloudflare bővítményt</a> a folytatáshoz."

#: views/SiteSettingsView.php:348
msgid "Save Changes"
msgstr "Módosítások mentése"

