#. Plugin Name of the plugin
#: ip-blacklist-for-cloudflare.php
msgid "IP Blacklist for Cloudflare"
msgstr "Чорний список IP для Cloudflare"

#. Description of the plugin
#: ip-blacklist-for-cloudflare.php
msgid "Blacklist IP addresses that attempt to login with a banned username through Cloudflare."
msgstr "Блокуйте IP-адреси, які намагаються увійти з забороненим іменем користувача через Cloudflare."

#. Author of the plugin
#: ip-blacklist-for-cloudflare.php
msgid "Miller Media"
msgstr "Miller Media"

#. Author URI of the plugin
#: ip-blacklist-for-cloudflare.php
msgid "www.millermedia.io"
msgstr "www.millermedia.io"

#: classes/Plugin.php:94
msgid "Removing IP from blacklist..."
msgstr "Видалення IP з чорного списку..."

#: classes/Plugin.php:95
msgid "There was an error."
msgstr "Сталася помилка."

#: classes/Plugin.php:96
#: views/SiteSettingsView.php:91
msgid "No IPs currently blacklisted."
msgstr "Наразі жодна IP-адреса не занесена до чорного списку."

#: classes/Plugin.php:97
msgid "IP address successfully removed from blacklist."
msgstr "IP-адресу успішно видалено з чорного списку."

#: classes/Plugin.php:98
msgid "Response from Cloudflare API unclear. Please refresh page."
msgstr "Відповідь від API Cloudflare незрозуміла. Будь ласка, оновіть сторінку."

#: classes/Plugin.php:99
msgid "Clearing log..."
msgstr "Очищення журналу..."

#: classes/Plugin.php:100
msgid "Log cleared."
msgstr "Журнал очищено."

#: classes/Plugin.php:101
msgid "Loading log..."
msgstr "Завантаження журналу..."

#: classes/Plugin.php:102
msgid "Remove From Blacklist"
msgstr "Видалити з чорного списку"

#: classes/Plugin.php:103
#: views/SiteSettingsView.php:291
msgid "Change Credentials"
msgstr "Змінити облікові дані"

#: classes/Plugin.php:104
msgid "Cancel"
msgstr "Скасувати"

#: classes/Plugin.php:105
#: views/SiteSettingsView.php:293
msgid "Disconnect"
msgstr "Від'єднати"

#: classes/Plugin.php:106
msgid "Are you sure you want to disconnect? Your Cloudflare credentials will be removed."
msgstr "Ви впевнені, що хочете від'єднатися? Ваші облікові дані Cloudflare буде видалено."

#: views/SiteSettingsView.php:8
#: views/SiteSettingsView.php:237
msgid "Cloudflare Credentials"
msgstr "Облікові дані Cloudflare"

#: views/SiteSettingsView.php:13
msgid "Authentication Method"
msgstr "Метод автентифікації"

#: views/SiteSettingsView.php:16
msgid "API Token (Recommended)"
msgstr "API-токен (рекомендовано)"

#: views/SiteSettingsView.php:17
#: views/SiteSettingsView.php:276
msgid "Global API Key (Legacy)"
msgstr "Глобальний API-ключ (застарілий)"

#: views/SiteSettingsView.php:24
msgid "Email Address"
msgstr "Адреса електронної пошти"

#: views/SiteSettingsView.php:25
msgid "Your Cloudflare account email address."
msgstr "Адреса електронної пошти вашого облікового запису Cloudflare."

#: views/SiteSettingsView.php:32
msgid "Global API Key"
msgstr "Глобальний API-ключ"

#: views/SiteSettingsView.php:33
msgid "Your <a href=\"https://dash.cloudflare.com/profile/api-tokens\" target=\"_blank\">Global API Key</a>.<br />Found under My Profile &rarr; API Tokens &rarr; Global API Key &rarr; View."
msgstr "Ваш <a href=\"https://dash.cloudflare.com/profile/api-tokens\" target=\"_blank\">глобальний API-ключ</a>.<br />Знаходиться в розділі Мій профіль &rarr; API-токени &rarr; Глобальний API-ключ &rarr; Переглянути."

#: views/SiteSettingsView.php:40
#: views/SiteSettingsView.php:270
msgid "API Token"
msgstr "API-токен"

#: views/SiteSettingsView.php:41
msgid "A <a href=\"https://dash.cloudflare.com/profile/api-tokens\" target=\"_blank\">scoped API token</a>.<br />Create one under My Profile &rarr; API Tokens &rarr; Create Token.<br />Required permissions: <strong>Zone &rarr; Zone &rarr; Read</strong>, <strong>Zone &rarr; Firewall Services &rarr; Edit</strong>."
msgstr "<a href=\"https://dash.cloudflare.com/profile/api-tokens\" target=\"_blank\">API-токен з обмеженими правами</a>.<br />Створіть його в розділі Мій профіль &rarr; API-токени &rarr; Створити токен.<br />Необхідні дозволи: <strong>Zone &rarr; Zone &rarr; Read</strong>, <strong>Zone &rarr; Firewall Services &rarr; Edit</strong>."

