msgid "A <a href=\"https://dash.cloudflare.com/profile/api-tokens\" target=\"_blank\">scoped API token</a>.<br />Create one under My Profile &rarr; API Tokens &rarr; Create Token.<br />Required permissions: <strong>Zone &rarr; Zone &rarr; Read</strong>, <strong>Zone &rarr; Firewall Services &rarr; Edit</strong>."
msgstr "Un <a href=\"https://dash.cloudflare.com/profile/api-tokens\" target=\"_blank\">token API cu domeniu limitat</a>.<br />Creați unul din Profilul meu &rarr; Token-uri API &rarr; Creați token.<br />Permisiuni necesare: <strong>Zonă &rarr; Zonă &rarr; Citire</strong>, <strong>Zonă &rarr; Servicii Firewall &rarr; Editare</strong>."

msgid "API Token"
msgstr "Token API"

msgid "API Token (Recommended)"
msgstr "Token API (Recomandat)"

msgid "Are you sure you want to disconnect? Your Cloudflare credentials will be removed."
msgstr "Sigur doriți să vă deconectați? Acreditările dvs. Cloudflare vor fi eliminate."

msgid "Authentication Method"
msgstr "Metodă de autentificare"

msgid "Banned Usernames"
msgstr "Nume de utilizator interzise"

msgid "Blacklist IPs"
msgstr "IP-uri pe lista neagră"

msgid "Blacklisted IPs"
msgstr "IP-uri blocate"

msgid "Cancel"
msgstr "Anulare"

msgid "Change Credentials"
msgstr "Schimbă acreditările"

msgid "Clear Log"
msgstr "Șterge jurnalul"

msgid "Clearing log..."
msgstr "Se șterge jurnalul..."

msgid "Cloudflare Credentials"
msgstr "Acreditări Cloudflare"

msgid "Comma-separated string, e.g. admin, administrator"
msgstr "Șir separat prin virgulă, de ex. admin, administrator"

msgid "Connected via %s"
msgstr "Conectat prin %s"

msgid "Connected via %sCloudflare plugin%s."
msgstr "Conectat prin %splugin-ul Cloudflare%s."

msgid "Disconnect"
msgstr "Deconectare"

msgid "Email Address"
msgstr "Adresă de e-mail"

msgid "Enable IP Blacklisting?"
msgstr "Activați lista neagră IP?"

msgid "Enable Logging?"
msgstr "Activați jurnalizarea?"

msgid "Global API Key"
msgstr "Cheie API globală"

msgid "Global API Key (Legacy)"
msgstr "Cheie API globală (Moștenită)"

msgid "Hey! You've been using %1$s for a while now. If you're enjoying it, would you mind %2$sleaving a 5-star review%3$s? It helps us keep improving! 🙏"
msgstr "Salut! Folosiți %1$s de ceva timp. Dacă vă place, ați putea %2$slăsa o recenzie de 5 stele%3$s? Ne ajută să continuăm să ne îmbunătățim! 🙏"

msgid "IP address successfully removed from blacklist."
msgstr "Adresa IP a fost eliminată cu succes din lista neagră."

msgid "IPs currently blocked from the site"
msgstr "IP-uri blocate în prezent de pe site"

msgid "Leave a Review"
msgstr "Lăsați o recenzie"

msgid "Loading log..."
msgstr "Se încarcă jurnalul..."

msgid "Log"
msgstr "Jurnal"

msgid "Log cleared."
msgstr "Jurnal șters."

msgid "Logging is currently disabled. To start logging, enable checkbox on settings tab."
msgstr "Jurnalizarea este dezactivată în prezent. Pentru a începe jurnalizarea, activați caseta de selectare din fila de setări."

msgid "Maybe Later"
msgstr "Poate mai târziu"

msgid "No IPs currently blacklisted."
msgstr "Niciun IP nu este blocat în prezent."

msgid "Please set your Cloudflare credentials below or install and configure the <a href=\"http://wordpress.org/plugins/cloudflare/\" target=\"_blank\">official Cloudflare plugin</a> to continue."
msgstr "Vă rugăm să setați acreditările dvs. Cloudflare mai jos sau să instalați și să configurați <a href=\"http://wordpress.org/plugins/cloudflare/\" target=\"_blank\">plugin-ul oficial Cloudflare</a> pentru a continua."

msgid "Remove From Blacklist"
msgstr "Elimină din lista neagră"

msgid "Removing IP from blacklist..."
msgstr "Se elimină IP-ul din lista neagră..."

msgid "Response from Cloudflare API unclear. Please refresh page."
msgstr "Răspunsul de la API-ul Cloudflare nu este clar. Vă rugăm să reîmprospătați pagina."

msgid "Save Changes"
msgstr "Salvează modificările"

msgid "Settings"
msgstr "Setări"

msgid "There was an error."
msgstr "A apărut o eroare."

msgid "Your <a href=\"https://dash.cloudflare.com/profile/api-tokens\" target=\"_blank\">Global API Key</a>.<br />Found under My Profile &rarr; API Tokens &rarr; Global API Key &rarr; View."
msgstr "<a href=\"https://dash.cloudflare.com/profile/api-tokens\" target=\"_blank\">Cheia dvs. API globală</a>.<br />Se găsește la Profilul meu &rarr; Token-uri API &rarr; Cheie API globală &rarr; Vizualizare."

msgid "Your Cloudflare account email address."
msgstr "Adresa de e-mail a contului dvs. Cloudflare."
