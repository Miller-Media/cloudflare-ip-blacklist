#: views/SiteSettingsView.php:33
msgid "Your <a href=\"https://dash.cloudflare.com/profile/api-tokens\" target=\"_blank\">Global API Key</a>.<br />Found under My Profile &rarr; API Tokens &rarr; Global API Key &rarr; View."
msgstr "Votre <a href=\"https://dash.cloudflare.com/profile/api-tokens\" target=\"_blank\">clé API globale</a>.<br />Disponible dans Mon profil &rarr; Jetons API &rarr; Clé API globale &rarr; Afficher."

#: views/SiteSettingsView.php:40
#: views/SiteSettingsView.php:270
msgid "API Token"
msgstr "Jeton API"

#: views/SiteSettingsView.php:41
msgid "A <a href=\"https://dash.cloudflare.com/profile/api-tokens\" target=\"_blank\">scoped API token</a>.<br />Create one under My Profile &rarr; API Tokens &rarr; Create Token.<br />Required permissions: <strong>Zone &rarr; Zone &rarr; Read</strong>, <strong>Zone &rarr; Firewall Services &rarr; Edit</strong>."
msgstr "Un <a href=\"https://dash.cloudflare.com/profile/api-tokens\" target=\"_blank\">jeton API avec portée limitée</a>.<br />Créez-en un dans Mon profil &rarr; Jetons API &rarr; Créer un jeton.<br />Permissions requises : <strong>Zone &rarr; Zone &rarr; Lecture</strong>, <strong>Zone &rarr; Services de pare-feu &rarr; Modification</strong>."

