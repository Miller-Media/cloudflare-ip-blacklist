msgid "A <a href=\"https://dash.cloudflare.com/profile/api-tokens\" target=\"_blank\">scoped API token</a>.<br />Create one under My Profile &rarr; API Tokens &rarr; Create Token.<br />Required permissions: <strong>Zone &rarr; Zone &rarr; Read</strong>, <strong>Zone &rarr; Firewall Services &rarr; Edit</strong>."
msgstr "En <a href=\"https://dash.cloudflare.com/profile/api-tokens\" target=\"_blank\">begränsad API-nyckel</a>.<br />Skapa en under Min profil &rarr; API-nycklar &rarr; Skapa nyckel.<br />Nödvändiga behörigheter: <strong>Zon &rarr; Zon &rarr; Läs</strong>, <strong>Zon &rarr; Brandväggstjänster &rarr; Redigera</strong>."

msgid "API Token"
msgstr "API-nyckel"

msgid "API Token (Recommended)"
msgstr "API-nyckel (rekommenderas)"

msgid "Are you sure you want to disconnect? Your Cloudflare credentials will be removed."
msgstr "Är du säker på att du vill koppla från? Dina Cloudflare-uppgifter kommer att tas bort."

msgid "Authentication Method"
msgstr "Autentiseringsmetod"

msgid "Banned Usernames"
msgstr "Förbjudna användarnamn"

msgid "Blacklist IPs"
msgstr "Svartlista IP-adresser"

msgid "Blacklisted IPs"
msgstr "Svartlistade IP-adresser"

msgid "Cancel"
msgstr "Avbryt"

msgid "Change Credentials"
msgstr "Ändra uppgifter"

msgid "Clear Log"
msgstr "Rensa logg"

msgid "Clearing log..."
msgstr "Rensar logg..."

msgid "Cloudflare Credentials"
msgstr "Cloudflare-uppgifter"

msgid "Comma-separated string, e.g. admin, administrator"
msgstr "Kommaseparerad sträng, t.ex. admin, administrator"

msgid "Connected via %s"
msgstr "Ansluten via %s"

msgid "Connected via %sCloudflare plugin%s."
msgstr "Ansluten via %sCloudflare-tillägget%s."

msgid "Disconnect"
msgstr "Koppla från"

msgid "Email Address"
msgstr "E-postadress"

msgid "Enable IP Blacklisting?"
msgstr "Aktivera IP-svartlistning?"

msgid "Enable Logging?"
msgstr "Aktivera loggning?"

msgid "Global API Key"
msgstr "Global API-nyckel"

msgid "Global API Key (Legacy)"
msgstr "Global API-nyckel (äldre)"

msgid "Hey! You've been using %1$s for a while now. If you're enjoying it, would you mind %2$sleaving a 5-star review%3$s? It helps us keep improving! 🙏"
msgstr "Hej! Du har använt %1$s ett tag nu. Om du gillar det, skulle du kunna %2$slämna en 5-stjärnig recension%3$s? Det hjälper oss att fortsätta förbättra! 🙏"

msgid "IP address successfully removed from blacklist."
msgstr "IP-adressen har tagits bort från svartlistan."

msgid "IPs currently blocked from the site"
msgstr "IP-adresser som för närvarande är blockerade från webbplatsen"

msgid "Leave a Review"
msgstr "Lämna en recension"

msgid "Loading log..."
msgstr "Laddar logg..."

msgid "Log"
msgstr "Logg"

msgid "Log cleared."
msgstr "Loggen har rensats."

msgid "Logging is currently disabled. To start logging, enable checkbox on settings tab."
msgstr "Loggning är för närvarande inaktiverad. För att börja logga, aktivera kryssrutan på inställningsfliken."

msgid "Maybe Later"
msgstr "Kanske senare"

msgid "No IPs currently blacklisted."
msgstr "Inga IP-adresser är för närvarande svartlistade."

msgid "Please set your Cloudflare credentials below or install and configure the <a href=\"http://wordpress.org/plugins/cloudflare/\" target=\"_blank\">official Cloudflare plugin</a> to continue."
msgstr "Ange dina Cloudflare-uppgifter nedan eller installera och konfigurera det <a href=\"http://wordpress.org/plugins/cloudflare/\" target=\"_blank\">officiella Cloudflare-tillägget</a> för att fortsätta."

msgid "Remove From Blacklist"
msgstr "Ta bort från svartlistan"

msgid "Removing IP from blacklist..."
msgstr "Tar bort IP från svartlistan..."

msgid "Response from Cloudflare API unclear. Please refresh page."
msgstr "Svar från Cloudflare API oklart. Vänligen uppdatera sidan."

msgid "Save Changes"
msgstr "Spara ändringar"

msgid "Settings"
msgstr "Inställningar"

msgid "There was an error."
msgstr "Ett fel uppstod."

msgid "Your <a href=\"https://dash.cloudflare.com/profile/api-tokens\" target=\"_blank\">Global API Key</a>.<br />Found under My Profile &rarr; API Tokens &rarr; Global API Key &rarr; View."
msgstr "Din <a href=\"https://dash.cloudflare.com/profile/api-tokens\" target=\"_blank\">globala API-nyckel</a>.<br />Finns under Min profil &rarr; API-nycklar &rarr; Global API-nyckel &rarr; Visa."

msgid "Your Cloudflare account email address."
msgstr "Din Cloudflare-kontos e-postadress."
