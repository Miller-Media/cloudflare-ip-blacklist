msgid "Hey! You've been using %1$s for a while now. If you're enjoying it, would you mind %2$sleaving a 5-star review%3$s? It helps us keep improving! 🙏"
msgstr "Hej! Używasz %1$s już od jakiegoś czasu. Jeśli Ci się podoba, czy mógłbyś %2$szostawić 5-gwiazdkową recenzję%3$s? To pomaga nam się rozwijać! 🙏"

msgid "Leave a Review"
msgstr "Zostaw recenzję"

msgid "Maybe Later"
msgstr "Może później"

msgid "Removing IP from blacklist..."
msgstr "Usuwanie IP z czarnej listy..."

msgid "There was an error."
msgstr "Wystąpił błąd."

msgid "No IPs currently blacklisted."
msgstr "Brak adresów IP na czarnej liście."

msgid "IP address successfully removed from blacklist."
msgstr "Adres IP został pomyślnie usunięty z czarnej listy."

msgid "Response from Cloudflare API unclear. Please refresh page."
msgstr "Odpowiedź z API Cloudflare jest niejasna. Odśwież stronę."

msgid "Clearing log..."
msgstr "Czyszczenie dziennika..."

msgid "Log cleared."
msgstr "Dziennik wyczyszczony."

msgid "Loading log..."
msgstr "Ładowanie dziennika..."

msgid "Remove From Blacklist"
msgstr "Usuń z czarnej listy"

msgid "Change Credentials"
msgstr "Zmień dane uwierzytelniające"

msgid "Cancel"
msgstr "Anuluj"

msgid "Disconnect"
msgstr "Rozłącz"

msgid "Are you sure you want to disconnect? Your Cloudflare credentials will be removed."
msgstr "Czy na pewno chcesz się rozłączyć? Twoje dane uwierzytelniające Cloudflare zostaną usunięte."

msgid "Cloudflare Credentials"
msgstr "Dane uwierzytelniające Cloudflare"

msgid "Authentication Method"
msgstr "Metoda uwierzytelniania"

msgid "API Token (Recommended)"
msgstr "Token API (zalecane)"

msgid "Global API Key (Legacy)"
msgstr "Globalny klucz API (starsza wersja)"

msgid "Email Address"
msgstr "Adres e-mail"

msgid "Your Cloudflare account email address."
msgstr "Adres e-mail Twojego konta Cloudflare."

msgid "Global API Key"
msgstr "Globalny klucz API"

msgid "Your <a href=\"https://dash.cloudflare.com/profile/api-tokens\" target=\"_blank\">Global API Key</a>.<br />Found under My Profile &rarr; API Tokens &rarr; Global API Key &rarr; View."
msgstr "Twój <a href=\"https://dash.cloudflare.com/profile/api-tokens\" target=\"_blank\">globalny klucz API</a>.<br />Znajduje się w Mój profil &rarr; Tokeny API &rarr; Globalny klucz API &rarr; Wyświetl."

msgid "API Token"
msgstr "Token API"

msgid "A <a href=\"https://dash.cloudflare.com/profile/api-tokens\" target=\"_blank\">scoped API token</a>.<br />Create one under My Profile &rarr; API Tokens &rarr; Create Token.<br />Required permissions: <strong>Zone &rarr; Zone &rarr; Read</strong>, <strong>Zone &rarr; Firewall Services &rarr; Edit</strong>."
msgstr "<a href=\"https://dash.cloudflare.com/profile/api-tokens\" target=\"_blank\">Token API o określonym zakresie</a>.<br />Utwórz go w Mój profil &rarr; Tokeny API &rarr; Utwórz token.<br />Wymagane uprawnienia: <strong>Strefa &rarr; Strefa &rarr; Odczyt</strong>, <strong>Strefa &rarr; Usługi zapory &rarr; Edycja</strong>."

msgid "Blacklist IPs"
msgstr "Czarna lista IP"

msgid "Enable IP Blacklisting?"
msgstr "Włączyć czarną listę IP?"

msgid "Banned Usernames"
msgstr "Zablokowane nazwy użytkowników"

msgid "Comma-separated string, e.g. admin, administrator"
msgstr "Ciąg oddzielony przecinkami, np. admin, administrator"

msgid "Enable Logging?"
msgstr "Włączyć rejestrowanie?"

msgid "Blacklisted IPs"
msgstr "Zablokowane adresy IP"

msgid "IPs currently blocked from the site"
msgstr "Adresy IP obecnie zablokowane na stronie"

msgid "Settings"
msgstr "Ustawienia"

msgid "Log"
msgstr "Dziennik"

msgid "Connected via %sCloudflare plugin%s."
msgstr "Połączono przez %swtyczkę Cloudflare%s."

msgid "Connected via %s"
msgstr "Połączono przez %s"

msgid "Please set your Cloudflare credentials below or install and configure the <a href=\"http://wordpress.org/plugins/cloudflare/\" target=\"_blank\">official Cloudflare plugin</a> to continue."
msgstr "Ustaw swoje dane uwierzytelniające Cloudflare poniżej lub zainstaluj i skonfiguruj <a href=\"http://wordpress.org/plugins/cloudflare/\" target=\"_blank\">oficjalną wtyczkę Cloudflare</a>, aby kontynuować."

msgid "Save Changes"
msgstr "Zapisz zmiany"

msgid "Logging is currently disabled. To start logging, enable checkbox on settings tab."
msgstr "Rejestrowanie jest obecnie wyłączone. Aby rozpocząć rejestrowanie, zaznacz pole wyboru na karcie ustawień."

msgid "Clear Log"
msgstr "Wyczyść dziennik"
