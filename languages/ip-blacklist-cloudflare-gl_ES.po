#: views/SiteSettingsView.php:286
#, php-format
msgid "Connected via %s"
msgstr "Conectado a través de %s"

#: views/SiteSettingsView.php:313
msgid "Please set your Cloudflare credentials below or install and configure the <a href=\"http://wordpress.org/plugins/cloudflare/\" target=\"_blank\">official Cloudflare plugin</a> to continue."
msgstr "Configure as súas credenciais de Cloudflare a continuación ou instale e configure o <a href=\"http://wordpress.org/plugins/cloudflare/\" target=\"_blank\">complemento oficial de Cloudflare</a> para continuar."

#: views/SiteSettingsView.php:348
msgid "Save Changes"
msgstr "Gardar cambios"

#: views/SiteSettingsView.php:356
msgid "Logging is currently disabled. To start logging, enable checkbox on settings tab."
msgstr "O rexistro está desactivado actualmente. Para comezar a rexistrar, active a caixa de verificación na pestana de configuración."

#: views/SiteSettingsView.php:363
msgid "Clear Log"
msgstr "Limpar rexistro"
