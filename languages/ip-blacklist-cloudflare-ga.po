#. Plugin Name of the plugin
#: ip-blacklist-for-cloudflare.php
msgid "IP Blacklist for Cloudflare"
msgstr "Liosta Dubh IP do Cloudflare"

#. Description of the plugin
#: ip-blacklist-for-cloudflare.php
msgid "Blacklist IP addresses that attempt to login with a banned username through Cloudflare."
msgstr "Cuir seoltaí IP ar an liosta dubh a dhéanann iarracht logáil isteach le hainm úsáideora coiscthe trí Cloudflare."

#. Author of the plugin
#: ip-blacklist-for-cloudflare.php
msgid "Miller Media"
msgstr "Miller Media"

#. Author URI of the plugin
#: ip-blacklist-for-cloudflare.php
msgid "www.millermedia.io"
msgstr "www.millermedia.io"

#: classes/Plugin.php:94
msgid "Removing IP from blacklist..."
msgstr "IP á bhaint den liosta dubh..."

#: classes/Plugin.php:95
msgid "There was an error."
msgstr "Tharla earráid."

#: classes/Plugin.php:96
#: views/SiteSettingsView.php:91
msgid "No IPs currently blacklisted."
msgstr "Níl aon IP ar an liosta dubh faoi láthair."

#: classes/Plugin.php:97
msgid "IP address successfully removed from blacklist."
msgstr "Baineadh an seoladh IP den liosta dubh go rathúil."

#: classes/Plugin.php:98
msgid "Response from Cloudflare API unclear. Please refresh page."
msgstr "Freagra ó API Cloudflare doiléir. Athnuaigh an leathanach le do thoil."

#: classes/Plugin.php:99
msgid "Clearing log..."
msgstr "Logaí á ghlanadh..."

#: classes/Plugin.php:100
msgid "Log cleared."
msgstr "Glanadh an logáil."

#: classes/Plugin.php:101
msgid "Loading log..."
msgstr "Logáil á lódáil..."

#: classes/Plugin.php:102
msgid "Remove From Blacklist"
msgstr "Bain den Liosta Dubh"

#: classes/Plugin.php:103
#: views/SiteSettingsView.php:291
msgid "Change Credentials"
msgstr "Athraigh Dintiúir"

#: classes/Plugin.php:104
msgid "Cancel"
msgstr "Cealaigh"

#: classes/Plugin.php:105
#: views/SiteSettingsView.php:293
msgid "Disconnect"
msgstr "Dínasc"

#: classes/Plugin.php:106
msgid "Are you sure you want to disconnect? Your Cloudflare credentials will be removed."
msgstr "An bhfuil tú cinnte gur mhaith leat dínascadh? Bainfear do dhintiúir Cloudflare."

#: views/SiteSettingsView.php:8
#: views/SiteSettingsView.php:237
msgid "Cloudflare Credentials"
msgstr "Dintiúir Cloudflare"

#: views/SiteSettingsView.php:13
msgid "Authentication Method"
msgstr "Modh Fíordheimhnithe"

#: views/SiteSettingsView.php:16
msgid "API Token (Recommended)"
msgstr "Comhartha API (Molta)"

#: views/SiteSettingsView.php:17
#: views/SiteSettingsView.php:276
msgid "Global API Key (Legacy)"
msgstr "Eochair API Dhomhanda (Oidhreacht)"

#: views/SiteSettingsView.php:24
msgid "Email Address"
msgstr "Seoladh Ríomhphoist"

#: views/SiteSettingsView.php:25
msgid "Your Cloudflare account email address."
msgstr "Seoladh ríomhphoist do chuntais Cloudflare."

#: views/SiteSettingsView.php:32
msgid "Global API Key"
msgstr "Eochair API Dhomhanda"

#: views/SiteSettingsView.php:33
msgid "Your <a href=\"https://dash.cloudflare.com/profile/api-tokens\" target=\"_blank\">Global API Key</a>.<br />Found under My Profile &rarr; API Tokens &rarr; Global API Key &rarr; View."
msgstr "D'<a href=\"https://dash.cloudflare.com/profile/api-tokens\" target=\"_blank\">Eochair API Dhomhanda</a>.<br />Le fáil faoi Mo Phróifíl &rarr; Comharthaí API &rarr; Eochair API Dhomhanda &rarr; Féach."

#: views/SiteSettingsView.php:40
#: views/SiteSettingsView.php:270
msgid "API Token"
msgstr "Comhartha API"

#: views/SiteSettingsView.php:41
msgid "A <a href=\"https://dash.cloudflare.com/profile/api-tokens\" target=\"_blank\">scoped API token</a>.<br />Create one under My Profile &rarr; API Tokens &rarr; Create Token.<br />Required permissions: <strong>Zone &rarr; Zone &rarr; Read</strong>, <strong>Zone &rarr; Firewall Services &rarr; Edit</strong>."
msgstr "<a href=\"https://dash.cloudflare.com/profile/api-tokens\" target=\"_blank\">Comhartha API scóipthe</a>.<br />Cruthaigh ceann faoi Mo Phróifíl &rarr; Comharthaí API &rarr; Cruthaigh Comhartha.<br />Ceadanna riachtanacha: <strong>Zone &rarr; Zone &rarr; Read</strong>, <strong>Zone &rarr; Firewall Services &rarr; Edit</strong>."

#: views/SiteSettingsView.php:47
#: views/SiteSettingsView.php:96
msgid "Blacklist IPs"
msgstr "Seoltaí IP ar Liosta Dubh"

#: views/SiteSettingsView.php:52
msgid "Enable IP Blacklisting?"
msgstr "Cumasaigh Liosta Dubh IP?"

#: views/SiteSettingsView.php:58
msgid "Banned Usernames"
msgstr "Ainmneacha Úsáideora Coiscthe"

#: views/SiteSettingsView.php:59
msgid "Comma-separated string, e.g. admin, administrator"
msgstr "Teaghrán scartha le camóga, m.sh. admin, administrator"

#: views/SiteSettingsView.php:64
msgid "Enable Logging?"
msgstr "Cumasaigh Logáil?"

#: views/SiteSettingsView.php:86
msgid "Blacklisted IPs"
msgstr "Seoltaí IP ar an Liosta Dubh"

#: views/SiteSettingsView.php:87
msgid "IPs currently blocked from the site"
msgstr "Seoltaí IP atá coiscthe ón suíomh faoi láthair"

#: views/SiteSettingsView.php:228
msgid "Settings"
msgstr "Socruithe"

#: views/SiteSettingsView.php:229
#: views/SiteSettingsView.php:352
msgid "Log"
msgstr "Logáil"

#: views/SiteSettingsView.php:255
#, php-format
msgid "Connected via %sCloudflare plugin%s."
msgstr "Nasctha trí %sbreiseán Cloudflare%s."

#: views/SiteSettingsView.php:286
#, php-format
msgid "Connected via %s"
msgstr "Nasctha trí %s"

#: views/SiteSettingsView.php:313
msgid "Please set your Cloudflare credentials below or install and configure the <a href=\"http://wordpress.org/plugins/cloudflare/\" target=\"_blank\">official Cloudflare plugin</a> to continue."
msgstr "Socraigh do dhintiúir Cloudflare thíos le do thoil nó suiteáil agus cumraigh an <a href=\"http://wordpress.org/plugins/cloudflare/\" target=\"_blank\">breiseán oifigiúil Cloudflare</a> chun leanúint ar aghaidh."

#: views/SiteSettingsView.php:348
msgid "Save Changes"
msgstr "Sábháil Athruithe"

#: views/SiteSettingsView.php:356
msgid "Logging is currently disabled. To start logging, enable checkbox on settings tab."
msgstr "Tá logáil díchumasaithe faoi láthair. Chun logáil a thosú, cumasaigh an ticbhosca ar an gcluaisín socruithe."

#: views/SiteSettingsView.php:363
msgid "Clear Log"
msgstr "Glan Logáil"
