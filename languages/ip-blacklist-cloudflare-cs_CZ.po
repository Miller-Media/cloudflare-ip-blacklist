msgid "API Token"
msgstr "API token"

msgid "API Token (Recommended)"
msgstr "API token (doporučeno)"

msgid "A <a href=\"https://dash.cloudflare.com/profile/api-tokens\" target=\"_blank\">scoped API token</a>.<br />Create one under My Profile &rarr; API Tokens &rarr; Create Token.<br />Required permissions: <strong>Zone &rarr; Zone &rarr; Read</strong>, <strong>Zone &rarr; Firewall Services &rarr; Edit</strong>."
msgstr "<a href=\"https://dash.cloudflare.com/profile/api-tokens\" target=\"_blank\">Omezený API token</a>.<br />Vytvořte jej v Můj profil &rarr; API tokeny &rarr; Vytvořit token.<br />Požadovaná oprávnění: <strong>Zóna &rarr; Zóna &rarr; Čtení</strong>, <strong>Zóna &rarr; Firewall služby &rarr; Úpravy</strong>."

msgid "Are you sure you want to disconnect? Your Cloudflare credentials will be removed."
msgstr "Opravdu se chcete odpojit? Vaše přihlašovací údaje Cloudflare budou odstraněny."

msgid "Authentication Method"
msgstr "Metoda ověření"

msgid "Banned Usernames"
msgstr "Zakázaná uživatelská jména"

msgid "Blacklisted IPs"
msgstr "Blokované IP adresy"

msgid "Blacklist IPs"
msgstr "Blokovat IP adresy"

msgid "Cancel"
msgstr "Zrušit"

msgid "Change Credentials"
msgstr "Změnit přihlašovací údaje"

msgid "Clearing log..."
msgstr "Mazání protokolu..."

msgid "Cloudflare Credentials"
msgstr "Přihlašovací údaje Cloudflare"

msgid "Comma-separated string, e.g. admin, administrator"
msgstr "Řetězec oddělený čárkami, např. admin, administrator"

msgid "Connected via %s"
msgstr "Připojeno přes %s"

msgid "Connected via %sCloudflare plugin%s."
msgstr "Připojeno přes %splugin Cloudflare%s."

msgid "Disconnect"
msgstr "Odpojit"

msgid "Email Address"
msgstr "E-mailová adresa"

msgid "Enable IP Blacklisting?"
msgstr "Povolit blokování IP adres?"

msgid "Enable Logging?"
msgstr "Povolit protokolování?"

msgid "Clear Log"
msgstr "Vymazat protokol"

msgid "Global API Key"
msgstr "Globální API klíč"

msgid "Global API Key (Legacy)"
msgstr "Globální API klíč (zastaralý)"

msgid "Hey! You've been using %1$s for a while now. If you're enjoying it, would you mind %2$sleaving a 5-star review%3$s? It helps us keep improving! 🙏"
msgstr "Ahoj! Používáte %1$s už nějakou dobu. Pokud jste spokojeni, nevadilo by vám %2$snapisat 5hvězdičkovou recenzi%3$s? Pomáhá nám to se neustále zlepšovat! 🙏"

msgid "IP address successfully removed from blacklist."
msgstr "IP adresa byla úspěšně odstraněna z blacklistu."

msgid "IPs currently blocked from the site"
msgstr "IP adresy aktuálně blokované na webu"

msgid "Leave a Review"
msgstr "Napsat recenzi"

msgid "Loading log..."
msgstr "Načítání protokolu..."

msgid "Log"
msgstr "Protokol"

msgid "Log cleared."
msgstr "Protokol vymazán."

msgid "Logging is currently disabled. To start logging, enable checkbox on settings tab."
msgstr "Protokolování je aktuálně vypnuté. Pro zapnutí zaškrtněte políčko na kartě nastavení."

msgid "Maybe Later"
msgstr "Možná později"

msgid "No IPs currently blacklisted."
msgstr "Momentálně nejsou blokovány žádné IP adresy."

msgid "Please set your Cloudflare credentials below or install and configure the <a href=\"http://wordpress.org/plugins/cloudflare/\" target=\"_blank\">official Cloudflare plugin</a> to continue."
msgstr "Nastavte prosím své přihlašovací údaje Cloudflare níže nebo nainstalujte a nakonfigurujte <a href=\"http://wordpress.org/plugins/cloudflare/\" target=\"_blank\">oficiální plugin Cloudflare</a> pro pokračování."

msgid "Remove From Blacklist"
msgstr "Odebrat z blacklistu"

msgid "Removing IP from blacklist..."
msgstr "Odebírání IP adresy z blacklistu..."

msgid "Response from Cloudflare API unclear. Please refresh page."
msgstr "Odpověď z Cloudflare API není jasná. Obnovte prosím stránku."

msgid "Save Changes"
msgstr "Uložit změny"

msgid "Settings"
msgstr "Nastavení"

msgid "There was an error."
msgstr "Došlo k chybě."

msgid "Your <a href=\"https://dash.cloudflare.com/profile/api-tokens\" target=\"_blank\">Global API Key</a>.<br />Found under My Profile &rarr; API Tokens &rarr; Global API Key &rarr; View."
msgstr "Váš <a href=\"https://dash.cloudflare.com/profile/api-tokens\" target=\"_blank\">Globální API klíč</a>.<br />Najdete jej v Můj profil &rarr; API tokeny &rarr; Globální API klíč &rarr; Zobrazit."

msgid "Your Cloudflare account email address."
msgstr "E-mailová adresa vašeho účtu Cloudflare."
